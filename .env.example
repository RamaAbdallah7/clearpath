# Copy this file to .env and paste your keys.
# .env is gitignored — never commit it, never paste a key into chat.
#
# BOTH keys are optional. ClearPath runs fully without them:
#   no OPENROUTER_API_KEY → stages use their written cues instead of AI ones
#   no ORS_API_KEY        → routing uses keyless Valhalla instead of the
#                           OpenRouteService wheelchair profile

# Personalised route cues. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Wheelchair routing profile. Free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# "What am I looking at?" on the Visit screen. The server fetches the Street
# View still with this key and sends the IMAGE to a vision model — the key
# itself never reaches the browser. Needs the Street View Static API enabled.
# (The Visit screen's 360 viewer uses a separate key you paste in the UI,
#  which only needs the free Maps Embed API.)
GOOGLE_MAPS_SERVER_KEY=

# Optional OpenRouter attribution headers. Leave blank to omit them.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ClearPath
