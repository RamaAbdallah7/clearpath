# Copy this file to .env and paste your keys.
# .env is gitignored — never commit it, never paste a key into chat.
#
# Both keys are optional, and there is no Google key: every map service
# ClearPath uses is free and keyless — OpenStreetMap tiles, Valhalla routing,
# Overpass facilities, Nominatim place names.
#
#   no OPENROUTER_API_KEY → written cues instead of personalised ones, and
#                           the assist screen falls back to volunteers only
#   no ORS_API_KEY        → keyless Valhalla instead of the OpenRouteService
#                           wheelchair profile

# Camera assist, personalised cues, plain-language explanations.
# Gemini is the documented default — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. Left blank, the proxy uses gemini-2.5-flash.
GEMINI_MODEL=

# Alternative provider, used only if GEMINI_API_KEY is unset.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Wheelchair routing profile. Free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=


# Optional OpenRouter attribution headers. Leave blank to omit them.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ClearPath
